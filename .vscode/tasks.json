{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "opencode: install dependencies",
      "type": "shell",
      "command": "[Console]::OutputEncoding = [System.Text.UTF8Encoding]::new($false); chcp 65001 > $null; & '${workspaceFolder}\\.vscode\\opencode.ps1' 'Install'",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command"]
        }
      },
      "problemMatcher": []
    },
    {
      "label": "opencode: desktop dev",
      "type": "shell",
      "command": "[Console]::OutputEncoding = [System.Text.UTF8Encoding]::new($false); chcp 65001 > $null; & '${workspaceFolder}\\.vscode\\opencode.ps1' 'Dev'",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command"]
        }
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "opencode: desktop build",
      "type": "shell",
      "command": "[Console]::OutputEncoding = [System.Text.UTF8Encoding]::new($false); chcp 65001 > $null; & '${workspaceFolder}\\.vscode\\opencode.ps1' 'Build'",
      "options": {
        "cwd": "${workspaceFolder}\\packages\\desktop",
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command"]
        }
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "opencode: desktop build prod sourcemap",
      "type": "shell",
      "command": "[Console]::OutputEncoding = [System.Text.UTF8Encoding]::new($false); chcp 65001 > $null; & '${workspaceFolder}\\.vscode\\opencode.ps1' 'BuildProdDebug'",
      "options": {
        "cwd": "${workspaceFolder}\\packages\\desktop",
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command"]
        }
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "opencode: desktop prepare prod debug",
      "type": "shell",
      "command": "[Console]::OutputEncoding = [System.Text.UTF8Encoding]::new($false); chcp 65001 > $null; & '${workspaceFolder}\\.vscode\\opencode.ps1' 'PrepareProdDebug'",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command"]
        }
      },
      "problemMatcher": []
    },
    {
      "label": "opencode: desktop package win",
      "type": "shell",
      "command": "[Console]::OutputEncoding = [System.Text.UTF8Encoding]::new($false); chcp 65001 > $null; & '${workspaceFolder}\\.vscode\\opencode.ps1' 'PackageWin'",
      "options": {
        "cwd": "${workspaceFolder}\\packages\\desktop",
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command"]
        }
      },
      "problemMatcher": []
    }
  ]
}
